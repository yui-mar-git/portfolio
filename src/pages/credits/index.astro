---
export const pageTitle = '使用素材';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { fetchMicroCMS } from '@/lib/microcms';
import type { MicroCMSCredits, MicroCMSListResponse } from '@/types/microcms';

const creditsResponse = await fetchMicroCMS<MicroCMSListResponse<MicroCMSCredits>>('credits', {
  limit: '100',
});
const microCMSCredits = creditsResponse.contents || [];

const STATIC_CREDITS = [
  {
    name: '魔王魂',
    author: '魔王魂',
    url: 'https://maou.audio/',
    usage: '制作物（/portfolio/）のゲーム各種 (BGM/ジングル)',
    license: '無料素材',
    category: ['SE', 'SE・BGM'],
  },
  {
    name: '効果音ラボ',
    author: '効果音ラボ',
    url: 'https://soundeffect-lab.info/',
    usage: '制作物（/portfolio/）のゲーム各種 (効果音)',
    license: '無料素材',
    category: ['SE', 'SE・BGM'],
  },
  {
    name: 'PANICPUMPKIN',
    author: 'PANICPUMPKIN',
    url: 'http://pansound.com/panicpumpkin/',
    usage: '制作物（/portfolio/）のゲーム各種 (SE/BGM)',
    license: '無料素材',
    category: ['SE', 'SE・BGM'],
  },
  {
    name: 'いらすとや',
    author: 'いらすとや',
    url: 'https://www.irasutoya.com/',
    usage: '制作物（/portfolio/）のゲーム各種 (イラスト/アイコン)',
    license: '無料素材',
    category: ['画像', '画像・イラスト'],
  },
  {
    name: 'Google Fonts',
    author: 'Google Fonts',
    url: 'https://fonts.google.com/',
    usage: 'Webサイト全般 (Inter / Noto Sans JP 等)',
    license: 'SIL Open Font License 1.1',
    category: ['フォント'],
  },
  {
    name: 'Simple Icons',
    author: 'Simple Icons',
    url: 'https://simpleicons.org/',
    usage: 'Webサイト全般',
    license: 'CC0 1.0 Universal',
    category: ['アイコン'],
  },
];

// 重複を除外してマージ
const staticNames = new Set(STATIC_CREDITS.map((item) => item.name.toLowerCase()));
const filteredMicroCMS = microCMSCredits.filter(
  (item) => !staticNames.has((item.name || '').toLowerCase()),
);

const allCredits = [...STATIC_CREDITS, ...filteredMicroCMS];

const categories = [
  {
    label: '画像',
    fullLabel: '画像・イラスト',
    emptyMsg: '現在、画像・イラストは使用していません。',
  },
  { label: 'フォント', fullLabel: 'フォント', emptyMsg: '現在、フォントは使用していません。' },
  { label: 'SE', fullLabel: 'SE・BGM', emptyMsg: '現在、SE・BGMは使用していません。' },
  { label: 'アイコン', fullLabel: 'アイコン', emptyMsg: '現在、アイコンは使用していません。' },
];

const getItemsByCategory = (label: string, fullLabel: string) => {
  return allCredits.filter((item) => {
    const rawCat = item.category;
    const catArray = Array.isArray(rawCat) ? rawCat : [rawCat];
    return catArray.some(
      (cat) => cat && (cat.includes(label) || fullLabel.includes(cat) || label.includes(cat)),
    );
  });
};
---

<BaseLayout title="Credits" pageId="credits">
  <Header activeId="credits" />

  <main class="container">
    <article>
      <span class="page-label">CREDITS</span>
      <h1>使用素材</h1>
      <section class="hero">
        <p>
          当サイトで使用している素材の一覧です。<br />
          各素材は提供元の利用規約に基づき使用しています。
        </p>
      </section>

      {
        categories.map((cat) => {
          const items = getItemsByCategory(cat.label, cat.fullLabel);
          return (
            <section>
              <h2>{cat.fullLabel}</h2>
              <div class="credits-table-container">
                <table class="credits-table">
                  <thead>
                    <tr>
                      <th>素材名</th>
                      <th>提供元</th>
                      <th>使用箇所</th>
                      <th>ライセンス</th>
                    </tr>
                  </thead>
                  <tbody>
                    {items.length > 0 ? (
                      items.map((item) => (
                        <tr>
                          <td>{item.name || '-'}</td>
                          <td>
                            {item.author && item.url ? (
                              <a href={item.url} target="_blank" rel="noopener noreferrer">
                                {item.author}
                              </a>
                            ) : item.url ? (
                              <a href={item.url} target="_blank" rel="noopener noreferrer">
                                リンク
                              </a>
                            ) : (
                              item.author || '-'
                            )}
                          </td>
                          <td>{item.usage || '-'}</td>
                          <td>{item.license || '-'}</td>
                        </tr>
                      ))
                    ) : (
                      <tr class="credits-empty">
                        <td colspan="4" class="empty-td">
                          {cat.emptyMsg}
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          );
        })
      }
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .empty-td {
    text-align: center;
    padding: 20px;
    color: var(--text-color-light);
  }
</style>
