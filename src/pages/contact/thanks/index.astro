---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout title="送信完了 | Portfolio" pageId="thanks">
  <Header activeId="thanks" />

  <main class="container">
    <article>
      <span class="page-label">THANKS</span>
      <h1>送信完了</h1>
      <section class="hero hero-thanks">
        <div class="thanks-content">
          <div class="thanks-icon">✉️</div>
          <p class="thanks-text">
            お問い合わせありがとうございます。<br />
            （※これはデモ画面です。実際にはどこにも送信されていません）
          </p>
          <a
            href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/contact/`}
            class="btn btn-secondary"
          >
            フォームへ戻る
          </a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero-thanks {
    text-align: center;
    padding: 3rem 1.5rem;
  }
  .thanks-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .thanks-icon {
    font-size: 3.5rem;
    line-height: 1;
  }
  .thanks-text {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted, #cbd5e1);
  }
</style>
