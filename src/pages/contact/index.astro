---
export const pageTitle = 'お問い合わせ';
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

declare global {
  var __DEV_RATE_LIMIT_KV__: Map<string, number> | undefined;
}

// Cloudflare 公式のテスト用キー（常に検証成功）。本番以外（Preview / ローカル）でのみ使用する。
// https://developers.cloudflare.com/turnstile/troubleshooting/testing/
const TURNSTILE_TEST_SITE_KEY = '1x00000000000000000000AA';
const TURNSTILE_TEST_SECRET_KEY = '1x0000000000000000000000000000000AA';
const GENERIC_ERROR_MSG =
  '送信できませんでした。お手数ですが、ページを再読み込みしてもう一度お試しください。';

const isProduction = __IS_PRODUCTION_DEPLOY__;
const runtimeEnv = Astro.locals.runtime?.env ?? {};

let errorMsg = '';
const siteKey = isProduction
  ? runtimeEnv.PUBLIC_TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
  : TURNSTILE_TEST_SITE_KEY;
const secretKey = isProduction ? runtimeEnv.TURNSTILE_SECRET_KEY : TURNSTILE_TEST_SECRET_KEY;

if (isProduction && !siteKey) {
  console.error('[contact] PUBLIC_TURNSTILE_SITE_KEY is not set for production.');
} else if (isProduction && /^[123]x0{10,}/.test(siteKey)) {
  console.error('[contact] PUBLIC_TURNSTILE_SITE_KEY for production is a Turnstile test key.');
}

async function verifyTurnstile(token: string, ip: string | null): Promise<boolean> {
  // 本番でシークレット未設定の場合は検証できないため、通過させずに拒否する（fail-closed）
  if (!secretKey) {
    console.error('[contact] TURNSTILE_SECRET_KEY is not set; rejecting submission.');
    return false;
  }
  const body = new URLSearchParams({ secret: secretKey, response: token });
  if (ip) body.set('remoteip', ip);
  const res = await fetch('https://challenges.cloudflare.com/turnstile/v0/siteverify', {
    method: 'POST',
    body,
  });
  if (!res.ok) {
    console.error('[contact] Turnstile siteverify HTTP error:', res.status);
    return false;
  }
  const result = await res.json();
  if (!result.success) {
    console.error('[contact] Turnstile verification failed:', result['error-codes']);
  }
  return !!result.success;
}

// 戻り値: 制限に達していれば true
async function isRateLimited(ip: string): Promise<boolean> {
  const LIMIT = 3;
  const rateLimitKv = runtimeEnv.RATE_LIMIT_KV;

  if (rateLimitKv) {
    const kvKey = `rate_limit:${ip}`;
    const currentCount = parseInt((await rateLimitKv.get(kvKey)) ?? '0', 10) || 0;
    if (currentCount >= LIMIT) return true;
    await rateLimitKv.put(kvKey, String(currentCount + 1), { expirationTtl: 3600 });
    return false;
  }

  // ローカル開発環境(npm run dev)でのレートリミット確認用インメモリキャッシュ
  const devKvMap = (globalThis.__DEV_RATE_LIMIT_KV__ ??= new Map<string, number>());
  const currentCount = devKvMap.get(ip) || 0;
  if (currentCount >= LIMIT) return true;
  devKvMap.set(ip, currentCount + 1);
  return false;
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const token = data.get('cf-turnstile-response');
    const ip =
      Astro.request.headers.get('cf-connecting-ip') ||
      Astro.request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() ||
      (Astro.clientAddress && Astro.clientAddress !== '::1' ? Astro.clientAddress : '127.0.0.1');

    if (typeof token !== 'string' || !token) {
      errorMsg = 'ボット対策の確認が完了していません。チェックボックスをオンにしてから送信してください。';
    } else if (!(await verifyTurnstile(token, Astro.request.headers.get('cf-connecting-ip')))) {
      errorMsg = GENERIC_ERROR_MSG;
    } else if (await isRateLimited(ip)) {
      errorMsg = '短時間に多数の送信が検知されました。1時間ほど時間を置いてから再度お試しください。';
    } else {
      // デモ用の擬似送信待ち（実際の送信処理は行わない）
      await new Promise((resolve) => setTimeout(resolve, 1500));
      const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
      return Astro.redirect(`${baseUrl}/contact/thanks/`);
    }
  } catch (err) {
    console.error('[contact] Unexpected error while handling submission:', err);
    errorMsg = GENERIC_ERROR_MSG;
  }
}
---

<BaseLayout title="Contact" pageId="contact">
  <Header activeId="contact" />
  <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
  ></script>

  <main class="container">
    <article>
      <span class="page-label">CONTACT</span>
      <h1>お問い合わせ</h1>
      <section class="hero">
        <p>お仕事のご依頼やご相談は、こちらのフォームからお気軽にご連絡ください。</p>

        {errorMsg && <div class="error-message">{errorMsg}</div>}

        <form method="POST" class="contact-form-container">
          <div class="form-group">
            <label class="form-label">お名前</label>
            <input type="text" class="form-control" name="name" placeholder="山田 太郎" />
          </div>
          <div class="form-group">
            <label class="form-label">メールアドレス</label>
            <input type="email" class="form-control" name="email" placeholder="example@email.com" />
          </div>
          <div class="form-group-last">
            <label class="form-label">メッセージ</label>
            <textarea
              rows="5"
              class="form-control"
              name="message"
              placeholder="ご用件をご記入ください"></textarea>
          </div>

          <button type="submit" class="btn btn-full submit-btn">送信する</button>

          {
            siteKey ? (
              <div class="cf-turnstile turnstile-container" data-sitekey={siteKey} data-theme="dark" />
            ) : (
              <div class="error-message">現在フォームを一時的にご利用いただけません。</div>
            )
          }

          <p class="dummy-notice">
            ※このフォームはポートフォリオ用のデモ（ダミー）です。<br />
            （Cloudflare KVによる1時間最大3回のレート制限と、1.5秒のモック送信処理が適用されています）<br />
            送信ボタンを押すと、完了ページ（サンクスページ）のデザインサンプルに遷移します。
          </p>
        </form>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .error-message {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #f87171;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md, 8px);
    margin-bottom: 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.5;
    font-weight: 500;
  }
  .submit-btn {
    margin: 0 auto;
    margin-bottom: 1.5rem;
  }
  .turnstile-container {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }
  .dummy-notice {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
    text-align: center;
    line-height: 1.5;
    margin-top: 1rem;
  }
</style>
