---
const { gameTitle } = Astro.props;
---

<div class="game-container" id="game-container">
  <!-- Game Area (Canvas) -->
  <!-- HUD (Score / Highscore / Coins / Active Items) -->
  <div class="game-hud" id="game-hud">
    <div class="hud-left">
      <div class="time-display"><span id="hud-mode-label">記録</span>: <span id="hud-sub-label"></span><span id="survival-time">0.0</span><span id="hud-unit-label">秒</span></div>
      <div class="coins-display" id="hud-coins-wrap">コイン: <span id="hud-coins">0</span></div>
    </div>
    <div class="hud-right">
      <div class="highscore-display hud-highscore-wrap" id="hud-highscore-wrap">
        ベスト: <span id="highscore">0.0</span>秒
      </div>
      <span id="hud-config-btn" class="icon-config hud-config-icon" title="コンフィグ">⚙️</span>
    </div>
  </div>

  <div class="bottom-hud bottom-hud-wrap" id="bottom-hud">
    <button id="retire-btn" class="btn btn-danger btn-retire-hud">リタイア</button>
  </div>
  <canvas id="game-canvas"></canvas>

  <!-- Screens -->
  <div class="overlay" id="start-screen">
    <h2>{gameTitle || 'エンドレス・ラン！'}</h2>
    <p class="start-desc">モードを選択してスタート</p>

    <div class="start-btn-group">
      <button id="start-btn" class="btn btn-primary btn-full">エンドレスモード</button>
      <button id="stage-btn" class="btn btn-primary btn-full">ステージモード</button>
      <button id="howto-btn" class="btn btn-secondary btn-full btn-howto">遊び方</button>
    </div>
    <span id="config-btn" class="icon-config start-config-icon" title="コンフィグ">⚙️</span>
  </div>

  <!-- ステージモード画面 (オーバーレイ) -->
  <div class="overlay screen-hidden" id="stage-mode-screen">
    <div id="stage-back-btn" class="global-back-btn" title="戻る">◀</div>
    <span id="stage-config-btn" class="icon-config start-config-icon" title="コンフィグ">⚙️</span>
    <div class="screen-header">
      <div class="screen-header-left">
        所持コイン: <span id="stage-coins-val">0</span> G
      </div>
    </div>
    <h2>ステージ選択</h2>
    <div class="stage-buttons" id="stage-list">
      <!-- JSで3ステージ分のボタンを生成 -->
    </div>
    <button id="shop-btn" class="btn btn-secondary btn-to-shop">ショップ</button>
  </div>

  <!-- ショップ画面 (オーバーレイ) -->
  <div class="overlay screen-hidden" id="shop-screen">
    <div id="shop-back-btn" class="global-back-btn" title="戻る">◀</div>
    <span id="shop-config-btn" class="icon-config start-config-icon" title="コンフィグ">⚙️</span>
    <div class="screen-header">
      <div class="screen-header-left">
        所持コイン: <span id="shop-coins-val">0</span> G
      </div>
    </div>
    <h2>ショップ</h2>
    <div class="shop-list-container" id="shop-items-grid">
      <!-- JSでベースキャンプ風のアイテムカードを生成 -->
    </div>
  </div>

  <!-- リザルト画面 -->
  <div class="overlay" id="result-screen">
    <h3 id="result-title" class="result-title">ゲームオーバー</h3>
    <p id="result-score-row"><span id="result-label">記録</span>: <span id="final-time" class="highlight">0.0</span> <span id="result-unit">秒</span></p>
    <p id="result-coins-earned-wrap" class="result-coins-earned">獲得コイン: +<span id="result-coins-earned">0</span> G</p>
    <div class="result-actions">
      <button id="retry-btn" class="btn btn-secondary btn-full">リトライ</button>
      <button id="stage-select-btn" class="btn btn-secondary btn-full" style="display: none;">ステージ選択へ</button>
      <button id="title-btn" class="btn btn-secondary btn-full">タイトルへ</button>
      <button id="share-btn" class="btn btn-primary btn-full btn-share">Xでシェア</button>
    </div>
  </div>

  <style>
    .game-hud {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      box-sizing: border-box;
      background: rgba(0, 0, 0, 0.55);
      padding: 0.5rem 1rem;
      z-index: 5;
      pointer-events: none;
      color: white;
      display: none;
      justify-content: space-between;
      align-items: center;
      font-size: 0.95rem;
      font-weight: bold;
    }

    .hud-left {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .hud-right {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    /* ヘッダー内有効アイテム（表示専用） */
    .hud-active-items {
      display: flex;
      gap: 0.35rem;
      align-items: center;
      pointer-events: none; /* プレイ中の切り替えは禁止 */
    }

    .hud-item-icon {
      width: 24px;
      height: 24px;
      background-size: cover;
      background-position: center;
      border-radius: 4px;
      border: 1px solid rgba(255, 255, 255, 0.5);
      cursor: pointer;
      pointer-events: auto;
    }

    .hud-item-icon.inactive {
      opacity: 0.3;
      filter: grayscale(100%);
    }

    .coins-display {
      color: #fbbf24;
      font-weight: bold;
    }

    .start-header-info {
      position: absolute;
      top: 1rem;
      left: 1rem;
      right: 3.5rem;
      display: flex;
      justify-content: space-between;
      font-weight: bold;
      color: var(--text-muted);
      font-size: 0.9rem;
      pointer-events: none;
    }

    .start-coins-val {
      color: #fbbf24;
    }

    /* game-containerの高さと背景色: 天の空 */
    #game-container {
      --game-height: 450px;
      background: #87ceeb;
    }

    :global([data-theme='dark']) #game-container {
      background: #1a2a40; /* 夜の空 */
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
    }

    #result-screen {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: rgba(0, 0, 0, 0.6);
    }

    .result-title {
      color: #ffffff;
      font-size: 1.6rem;
      margin-bottom: 0.5rem;
    }

    .result-coins-earned {
      color: #fbbf24;
      font-weight: bold;
      font-size: 1.1rem;
      margin-top: -0.5rem;
      margin-bottom: 1rem;
    }

    .start-desc {
      color: var(--text-muted);
      margin-bottom: 1.25rem;
      font-size: 0.85rem;
    }

    :global(.stage-buttons) {
      display: flex !important;
      flex-direction: row !important;
      gap: 1rem !important;
      justify-content: center !important;
      align-items: center !important;
      width: 90% !important;
      max-width: 500px !important;
      margin-top: 1.5rem !important;
    }

    .start-btn-group {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      width: 100%;
      max-width: 280px;
      margin-left: auto;
      margin-right: auto;
    }

    .btn-full {
      width: 100%;
      max-width: 280px;
      margin-left: auto;
      margin-right: auto;
    }

    .btn-share {
      background-color: #1da1f2;
      border-color: #1da1f2;
    }

    .btn-howto {
      margin-top: 0;
      width: 100%;
    }

    .btn-config-howto {
      margin-bottom: 0.5rem;
    }

    .btn-danger {
      background-color: #dc3545;
      color: white;
      border-color: #dc3545;
    }

    .btn-danger:hover {
      background-color: #c82333;
    }

    .result-actions {
      display: flex;
      flex-direction: column;
      width: 80%;
      max-width: 300px;
      gap: 1rem;
      margin-top: 2rem;
      margin-left: auto;
      margin-right: auto;
    }

    .howto-content {
      text-align: left;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }

    .howto-page {
      text-align: left;
      line-height: 1.8;
    }

    /* === 動的生成要素用グローバルスタイル (:global) === */
    :global(.btn-stage-td) {
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
      font-weight: bold;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #00d2ff;
      color: #ffffff;
      border: 2px solid white;
      border-radius: 8px;
      cursor: pointer;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
      transition: all 0.2s ease;
      flex: 1;
      max-width: 170px;
      min-width: 0;
      box-sizing: border-box;
      white-space: nowrap;
    }

    :global(.btn-stage-td:hover:not(:disabled)) {
      background: #38e8ff;
      transform: translateY(-2px);
    }

    :global(.btn-stage-td.stage-cleared) {
      background: #ffd700;
      color: #1a1a2e;
      border-color: #fff;
      font-weight: bold;
    }

    :global(.btn-stage-td:disabled) {
      background: #3a3a4c;
      color: #777777;
      border-color: #333333;
      box-shadow: none;
      cursor: not-allowed;
      opacity: 1;
    }

    :global(.stage-badge) {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: rgba(0, 0, 0, 0.3);
    }

    :global(.shop-item-row) {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.75rem;
      border-radius: 8px;
      width: 100%;
      box-sizing: border-box;
    }

    :global(.shop-item-icon-box) {
      width: 44px;
      height: 44px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: #000;
      overflow: hidden;
      flex-shrink: 0;
    }

    :global(.shop-item-img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    :global(.shop-item-info) {
      display: flex;
      flex-direction: column;
      flex: 1;
      text-align: left;
      gap: 0.15rem;
    }

    :global(.shop-item-name) {
      font-weight: bold;
      font-size: 0.9rem;
      color: #ffffff;
    }

    :global(.shop-item-desc) {
      font-size: 0.75rem;
      color: var(--text-muted, #94a3b8);
      line-height: 1.25;
    }

    :global(.shop-item-actions) {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.35rem;
      flex-shrink: 0;
    }

    :global(.shop-item-actions .btn-buy) {
      min-width: 120px !important;
      width: 120px !important;
      text-align: center !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0.4rem 0.5rem !important;
      font-size: 0.8rem !important;
      box-sizing: border-box !important;
      white-space: nowrap !important;
    }

    :global(.btn-buy) {
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
      font-weight: bold;
      white-space: nowrap;
    }

    :global(.btn-buy:disabled) {
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-muted, #64748b);
      border-color: transparent;
      cursor: not-allowed;
    }

    :global(.btn-buy.item-unreleased) {
      opacity: 0.5;
    }

    :global(.btn-toggle-switch) {
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    :global(.btn-toggle-switch.on) {
      background: #10b981;
      color: #ffffff;
      border-color: #10b981;
    }

    :global(.btn-toggle-switch.off) {
      background: #475569;
      color: #cbd5e1;
      border-color: #475569;
    }

    :global(.btn-toggle-switch:disabled) {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .howto-text {
      color: var(--text-muted);
      margin: 0;
    }

    .credits-list {
      margin-top: 1rem;
      padding-left: 1.5rem;
    }

    /* タワーディフェンス風 ステージ選択モーダル */
    .stage-modal {
      width: 90%;
      max-width: 500px;
      max-height: 380px;
      overflow-y: auto;
      background: var(--surface, #1e293b);
      border: 1px solid var(--border-color, rgba(255, 255, 255, 0.15));
      border-radius: 12px;
    }

    .stage-buttons {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 1.25rem;
    }

    /* === Overlay styles === */
    .global-back-btn {
      position: absolute;
      top: 1rem;
      left: 1rem;
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1.2rem;
      z-index: 20;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.2s;
    }

    .global-back-btn:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: scale(1.05);
    }

    .screen-header {
      position: absolute;
      top: 1.2rem;
      right: 3.8rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      z-index: 20;
    }

    .screen-header-left {
      color: #fbbf24;
      font-weight: bold;
      font-size: 0.95rem;
    }

    .screen-header-right {
      display: flex;
    }

    .header-active-items {
      pointer-events: auto;
    }

    .screen-hidden {
      display: none;
    }

    /* ステージモード画面 */
    #stage-mode-screen {
      background-color: #0f172a;
    }

    #stage-mode-screen h2 {
      margin-top: 0;
    }

    .btn-to-shop {
      margin-top: 1.5rem;
      width: 90%;
      max-width: 500px;
    }

    /* ショップ画面 */
    #shop-screen {
      background-color: #0f172a;
    }
    
    #shop-screen h2 {
      margin-top: 0;
      margin-bottom: 0.5rem;
    }

    .shop-list-container {
      width: 90%;
      max-width: 500px;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      overflow-y: auto;
      max-height: 60vh;
      padding: 0.5rem;
    }

    /* アイテム設定モーダル */
    .item-setting-modal {
      width: 90%;
      max-width: 450px;
      max-height: 400px;
      overflow-y: auto;
      background: var(--surface, #1e293b);
      border: 1px solid var(--border-color, rgba(255, 255, 255, 0.15));
      border-radius: 12px;
      padding: 1.25rem;
    }

    .item-setting-notice {
      font-size: 0.75rem;
      color: #fca5a5;
      margin-top: 0.4rem;
      margin-bottom: 0.8rem;
      text-align: center;
      font-weight: bold;
    }

    .item-setting-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .btn-toggle-switch {
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .btn-toggle-switch.on {
      background: #10b981;
      color: #ffffff;
      border-color: #10b981;
    }

    .btn-toggle-switch.off {
      background: #475569;
      color: #cbd5e1;
      border-color: #475569;
    }

    .btn-toggle-switch:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Overlay base class */
    .overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      z-index: 10;
    }

    /* start-screen default display */
    #start-screen {
      display: flex;
      background-color: var(--bg-color);
    }

    .overlay h2 {
      color: #fff;
      margin-bottom: 1rem;
      font-size: 2rem;
    }

    .overlay p {
      color: #f8f9fa;
      margin-bottom: 2rem;
      font-weight: bold;
    }

    .highlight {
      font-size: 2.5rem;
      color: #ffea00;
      margin: 0 0.5rem;
    }

    .hud-highscore-wrap {
      display: flex;
      align-items: center;
    }

    .hud-config-icon {
      position: relative;
      top: auto;
      right: auto;
      margin-left: 0.5rem;
      cursor: pointer;
      pointer-events: auto;
    }

    .bottom-hud-wrap {
      position: absolute;
      bottom: 1rem;
      right: 1rem;
      z-index: 5;
      display: none;
      pointer-events: auto;
    }

    .btn-retire-hud {
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
    }

    .start-config-icon {
      cursor: pointer;
    }
  </style>
</div>
