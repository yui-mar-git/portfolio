  /* ===== 属性カラードット（card-descの下・右下に出る小さな丸） ===== */
  /* .card-color-dot はJS側でcardに.card-color-dot要素を追加して使う */
  :global(.card-color-dot) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    position: absolute;
    bottom: 5px;
    right: 5px;
