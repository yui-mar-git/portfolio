---
import yuusyaImg from '../../assets/games/roguelike/images/characters/figure_rpg_character_yuusya.png';
import kenshiImg from '../../assets/games/roguelike/images/characters/figure_rpg_character_kenshi.png';
import mahoutsukaiImg from '../../assets/games/roguelike/images/characters/figure_rpg_character_mahoutsukai.png';
import butoukaImg from '../../assets/games/roguelike/images/characters/figure_rpg_character_butouka.png';
import hotelImg from '../../assets/games/roguelike/images/map/building_hotel_pet.png';
import pixyImg from '../../assets/games/roguelike/images/characters/fantasy_pixy2.png';
import shopImg from '../../assets/games/roguelike/images/map/omise_shop_tatemono.png';
import noImageImg from '../../assets/games/roguelike/images/icons/no_image_square.jpg';
import kingImg from '../../assets/games/roguelike/images/characters/royal_king.png';

const { projectData } = Astro.props;
---

<div class="game-container" id="game-container">
  <span id="config-btn" class="icon-config" title="コンフィグ">⚙️</span>

  <!-- ゲームヘッダーバー（ステータス常時表示） -->
  <div id="game-header" class="game-header-bar game-header-custom">
    <div class="header-status">
      <span id="header-floor" class="header-floor-text">エリア 1 - 0層</span>
      <span class="gold-badge"><span id="header-gold">50</span> G</span>
      <span class="hp-badge">HP: <span id="header-hp">10/10</span></span>
      <span class="mp-badge">MP: <span id="header-mp">5/5</span></span>
      <div class="header-relics">
        <span class="header-relics-label">レリック:</span>
        <div id="header-relics-list" class="header-relics-list-container"></div>
      </div>
    </div>
  </div>

  <!-- ゲームフッターバー（アイテム・デッキ常時表示） -->
  <div id="game-footer" class="game-footer-bar game-footer-custom">
    <div class="btn-shop-service-leave-custom">
      <span class="town-items-custom">アイテム:</span>
      <div id="footer-player-items" class="footer-player-items-custom"></div>
    </div>
    <button class="btn btn-secondary btn-sm btn-footer-view-deck-custom" id="btn-footer-view-deck"
      >デッキ確認 (<span id="footer-deck-count">0</span>)</button
    >
  </div>
  <!-- ゲームオーバー/クリア画面 -->
  <div id="result-overlay" class="rl-overlay result-overlay-custom">
    <h2 id="result-title">戦闘終了</h2>
    <p id="result-details" class="result-details-custom"></p>
    <div class="result-actions">
      <button class="btn btn-primary" id="btn-next">次の戦闘へ</button>
      <button class="btn btn-secondary" id="btn-title">タイトルへ</button>
      <button class="btn btn-share-custom" id="btn-share">Xでシェア</button>
    </div>
  </div>

  <!-- カード選択報酬画面 -->
  <div id="reward-overlay" class="rl-overlay reward-overlay-custom">
    <h2>🎉 戦闘勝利！</h2>
    <p class="reward-subtitle" id="reward-subtitle-text">1枚カードを選んでデッキに追加</p>
    <div id="reward-cards" class="reward-cards"></div>
    <button class="btn btn-secondary btn-skip-reward-custom" id="btn-skip-reward">スキップ</button>
  </div>

  <!-- デッキ閲覧モーダル -->
  <div id="deck-viewer-overlay" class="rl-overlay deck-viewer-overlay-custom">
    <h2 class="deck-view-title">デッキ確認</h2>
    <div class="deck-viewer-tabs">
      <button class="deck-tab active" data-target="deck-list"
        >山札 (<span id="dv-deck-count">0</span>)</button
      >
      <button class="deck-tab" data-target="discard-list"
        >捨て札 (<span id="dv-discard-count">0</span>)</button
      >
      <button class="deck-tab" data-target="hand-list"
        >手札 (<span id="dv-hand-count">0</span>)</button
      >
    </div>
    <div id="deck-list" class="dv-card-list active"></div>
    <div id="discard-list" class="dv-card-list"></div>
    <div id="hand-list" class="dv-card-list"></div>
    <button class="btn btn-secondary close-deck-viewer-custom" id="close-deck-viewer">閉じる</button
    >
  </div>

  <!-- スタート画面 -->
  <div id="start-screen" class="start-screen-custom">
    <h2 class="game-main-title">{projectData ? projectData.title : 'ローグライクカードゲーム'}</h2>
    <p class="game-main-desc">
      職業・属性・状態異常・ゴールドを駆使する本格ローグライク<br />※スタートするとBGMが鳴ります
    </p>
    <button id="start-btn" class="btn btn-full">冒険を始める</button>
    <button id="howto-btn" class="btn btn-secondary btn-full howto-btn-custom">遊び方</button>
  </div>

  <!-- 職業選択画面 -->
  <div id="class-select-screen" class="class-select-screen-custom">
    <h2 class="hero-select-title">冒険者の選択</h2>
    <p class="hero-select-desc">あなたの戦闘スタイルを選んで旅立ちましょう。</p>
    <div class="hero-stats-wrapper">
      <div class="class-grid class-grid-custom">
        <div class="class-card" data-class="yuusya">
          <img src={yuusyaImg.src} class="hero-icon-img" />
          <div class="hero-name-label">勇者</div>
          <div class="hero-hp-label">HP10 / MP5<br />初期レリックが+1個</div>
        </div>
        <div class="class-card" data-class="kenshi">
          <img src={kenshiImg.src} class="hero-icon-img" />
          <div class="hero-name-label">戦士</div>
          <div class="hero-hp-label">HP15 / MP4<br />毎ターンHP+1回復</div>
        </div>
        <div class="class-card" data-class="mahoutsukai">
          <img src={mahoutsukaiImg.src} class="hero-icon-img" />
          <div class="hero-name-label">魔法使い</div>
          <div class="hero-hp-label">HP7 / MP7<br />毎ターンMP+1回復</div>
        </div>
        <div class="class-card" data-class="butouka">
          <img src={butoukaImg.src} class="hero-icon-img" />
          <div class="hero-name-label">格闘家</div>
          <div class="hero-hp-label">HP8 / MP4<br />毎ターン行動回数+1</div>
        </div>
      </div>
      <p id="class-select-preview" class="class-select-preview-custom">勇者が選択されています</p>
    </div>

    <button id="btn-back-to-title" class="btn btn-secondary btn-full btn-back-to-title-custom"
      >戻る</button
    >
  </div>

  <!-- マップ進行画面（横スクロール双六マップ） -->
  <div id="map-screen" class="map-screen-custom">
    <button id="btn-retire-map" class="btn btn-secondary btn-sm btn-retire-map-custom"
      >リタイア</button
    >

    <!-- 横スクロールすごろく本体 -->
    <div id="map-scroll-wrapper" class="map-scroll-wrapper-custom">
      <div id="map-board" class="map-board-custom">
        <!-- JSですごろくノードが左から右に動的描画されます。接続線はCSSまたはSVG -->
      </div>
    </div>
  </div>

  <!-- 宿（回復）画面 -->
  <div id="inn-screen" class="inn-screen-custom">
    <img src={hotelImg.src} class="town-icon-img" />
    <h3 class="town-title">旅人の宿</h3>
    <p class="town-desc">お金を払って、宿屋で休むことができます。</p>
    <div class="town-btn-group">
      <button id="btn-inn-rest-half" class="btn btn-primary btn-inn-rest-half-custom"
        >小休憩 (💰15) <br /><span class="town-btn-text">HP/MP 50%回復</span></button
      >
      <button id="btn-inn-rest-full" class="btn btn-primary btn-inn-rest-full-custom"
        >宿泊 (💰30) <br /><span class="town-btn-text">HP/MP全快 ＋ 状態異常全治</span></button
      >
      <button id="btn-inn-leave" class="btn btn-secondary btn-inn-leave-custom">立ち去る</button>
    </div>
  </div>

  <!-- ショップサービス（強化・削除）画面 -->
  <div id="shop-service-screen" class="shop-service-screen-custom">
    <div class="town-status-wrap">
      <h3 id="shop-service-title" class="shop-service-title-custom">ショップサービス</h3>
      <p id="shop-service-desc" class="shop-service-desc-custom"></p>
    </div>

    <!-- 対象カード選択リスト -->
    <div id="shop-service-card-list" class="shop-service-card-list-custom"></div>

    <div class="town-shop-wrap">
      <button
        id="btn-shop-service-leave"
        class="btn btn-secondary btn-sm btn-shop-service-leave-custom">キャンセル</button
      >
    </div>
  </div>

  <!-- 街（ショップ）画面 -->
  <div id="town-screen" class="town-screen-custom">
    <div class="shop-header">
      <h3 class="shop-title">よろず街の商い</h3>
      <button id="btn-town-leave" class="btn btn-secondary btn-sm btn-town-leave-custom"
        >街を出る</button
      >
    </div>

    <div class="shop-card-list">
      <div>
        <p class="shop-card-category">販売カード</p>
        <div id="town-cards" class="town-cards-custom"></div>
      </div>
      <div>
        <p class="shop-card-category">販売アイテム</p>
        <div id="town-items" class="town-items-custom"></div>
      </div>
      <div class="shop-relic-wrap">
        <p class="shop-relic-title">特別サービス</p>
        <div class="shop-relic-list">
          <button id="btn-town-upgrade" class="btn btn-primary btn-sm btn-town-upgrade-custom"
            >カード強化 (20 G)</button
          >
          <button id="btn-town-remove" class="btn btn-primary btn-sm btn-town-remove-custom"
            >カード削除 (20 G)</button
          >
        </div>
      </div>
    </div>
  </div>

  <!-- イベント画面 -->
  <div id="event-screen" class="event-screen-custom">
    <div>
      <img id="event-image" src={noImageImg.src} class="event-image-custom" />
      <h3 id="event-title" class="event-title-custom">未知のイベント</h3>
      <p id="event-text" class="event-text-custom"></p>
    </div>

    <div id="event-options" class="event-options-custom">
      <!-- イベントの選択肢ボタンがJSで動的に追加されます -->
    </div>
  </div>

  <!-- アイテム使用確認モーダル -->
  <div id="item-confirm-modal" class="item-confirm-modal-custom">
    <div class="item-modal-inner">
      <h4 id="item-confirm-title" class="item-confirm-title-custom">アイテムの使用確認</h4>
      <img
        id="item-confirm-image"
        src=""
        alt=""
        style="display:none; width:80px; height:80px; object-fit:contain; margin:0 auto 0.5rem auto;"
      />
      <p id="item-confirm-text" class="item-confirm-text-custom"></p>
      <div class="item-modal-btn-group">
        <button id="btn-item-confirm-yes" class="btn btn-primary btn-item-confirm-yes-custom"
          >はい</button
        >
        <button id="btn-item-confirm-no" class="btn btn-secondary btn-item-confirm-no-custom"
          >いいえ</button
        >
      </div>
    </div>
  </div>

  <!-- 戦闘中マップ確認モーダル -->
  <div id="battle-map-overlay" class="overlay battle-map-overlay-custom">
    <h3 class="battle-map-title">現在地確認</h3>
    <div id="battle-map-scroll-wrapper" class="battle-map-scroll-wrapper-custom">
      <div id="battle-map-board" class="battle-map-board-custom"></div>
    </div>
    <button class="btn btn-secondary btn-close-battle-map-custom" id="btn-close-battle-map"
      >閉じる</button
    >
  </div>

  <!-- 王様遭遇イベントモーダル -->
  <div id="king-event-modal" class="overlay king-event-modal-custom">
    <img src={kingImg.src} class="king-icon-img" />
    <h3 class="king-title">謁見の間：王からの餞別</h3>
    <p class="king-desc">
      「よくぞ来た、勇猛なる旅人よ。この地に巣食う魔王を討ち果たすのだ。<br
      />お前にこの伝説の遺物（レリック）から一つを授けよう…」
    </p>
    <div id="king-relic-choices" class="king-relic-choices-custom">
      <!-- 3つのレリック選択カードがJSで挿入されます -->
    </div>
  </div>

  <!-- 汎用カットシーンモーダル -->
  <div id="cutscene-modal" class="overlay cutscene-modal-custom">
    <!-- 背景イメージ -->
    <div id="cutscene-bg" class="cutscene-bg-custom"></div>
    <!-- キャラクターポートレート群 -->
    <div id="cutscene-portraits" class="cutscene-portraits-custom"></div>
    <!-- セリフウィンドウ -->
    <div class="king-modal-inner">
      <div id="cutscene-speaker" class="cutscene-speaker-custom"></div>
      <div id="cutscene-text" class="cutscene-text-custom"></div>
      <div class="king-btn-wrap">
        <button id="btn-cutscene-next" class="btn btn-primary btn-cutscene-next-custom"
          >次へ ▶</button
        >
      </div>
    </div>
  </div>

  <!-- ゲーム内汎用メッセージダイアログ -->

  <div id="game-dialog-modal" class="overlay game-dialog-modal-custom">
    <div class="deck-card-list-wrap">
      <h4 id="dialog-title" class="dialog-title-custom">通知</h4>
      <p id="dialog-message" class="dialog-message-custom"></p>
      <div id="dialog-buttons" class="dialog-buttons-custom">
        <button id="btn-dialog-ok" class="btn btn-primary btn-dialog-ok-custom">OK</button>
        <button id="btn-dialog-yes" class="btn btn-primary btn-dialog-yes-custom">はい</button>
        <button id="btn-dialog-no" class="btn btn-secondary btn-dialog-no-custom">いいえ</button>
      </div>
      <div id="dialog-extra" class="dialog-extra-custom"></div>
    </div>
  </div>

  <!-- カード詳細モーダル -->
  <div id="card-detail-modal" class="overlay card-detail-modal card-detail-modal-custom">
    <div class="card-detail-container">
      <button id="btn-close-card-detail" class="btn-close-card-detail">&times;</button>
      <div id="card-detail-content" class="card-detail-content">
        <!-- カードが入る -->
      </div>
      <div id="card-detail-desc" class="card-detail-desc"></div>
    </div>
  </div>

  <!-- バトル画面本体 -->
  <div class="battle-layout battle-layout-custom">
    <button class="btn btn-secondary btn-sm btn-battle-retire-custom" id="btn-battle-retire"
      >リタイア</button
    >

    <!--バトルフィールド -->
    <div class="battle-field">
      <!-- ① 左上：敵ステータス -->
      <div class="enemy-status-panel">
        <div class="status-header enemy-header">
          <span id="enemy-name">敵</span>
          <span id="enemy-poison-badge" class="poison-badge enemy-poison-badge-custom"></span>
        </div>
        <div class="status-row">
          <span class="status-label">HP</span>
          <div class="hp-bar-bg enemy-hp-bg">
            <div id="enemy-hp-bar" class="hp-bar-fill enemy-hp-fill"></div>
          </div>
          <span id="enemy-hp-text" class="status-text enemy-text">40/40</span>
        </div>
        <div id="enemy-intent" class="enemy-intent-badge">⚔️ 5</div>
      </div>

      <!-- ② 右上：敵画像 -->
      <div class="battle-image-container">
        <img id="enemy-image" src="" alt="敵" class="battle-image enemy-image" />
      </div>

      <!-- ③ 左下：自分画像 -->
      <div class="battle-image-container player-image-container">
        <img id="player-battle-image" src="" alt="自分" class="battle-image player-image" />
      </div>

      <!-- ④ 右下：自分ステータス -->
      <div class="player-status-panel">
        <div class="status-header player-header">
          <span id="player-poison-badge" class="poison-badge player-poison-badge-custom"></span>
          <span id="player-class-name">あなた</span>
        </div>
        <div class="status-row">
          <span class="status-label">HP</span>
          <div class="hp-bar-bg player-hp-bg">
            <div id="player-hp-bar" class="hp-bar-fill player-hp-fill"></div>
          </div>
          <span id="player-hp-text" class="status-text player-text">10/10</span>
        </div>
        <div class="status-row player-mp-row">
          <span class="status-label mp-label">MP</span>
          <div id="player-mp-orbs" class="player-mp-orbs"></div>
          <span id="player-mp-text" class="status-text mp-text">5/5</span>
        </div>
        <div class="player-actions-text">
          行動: <span id="player-actions">1</span>回
        </div>
      </div>
    </div><!-- /.battle-field -->

    <!-- バトルログ (コンパクト) -->
    <div class="battle-log-panel battle-log-custom" id="battle-log">
      <p class="log-system">戦闘開始！</p>
    </div>

    <!-- 手札エリア -->
    <div class="town-upgrade-wrap">
      <div class="town-upgrade-header">
        <button class="btn btn-secondary btn-sm btn-battle-view-map-custom" id="btn-battle-view-map"
          >マップ</button
        >
        <button class="btn btn-end-turn btn-sm btn-end-turn-custom" id="btn-end-turn">様子見</button
        >
      </div>
      <div id="hand-area" class="hand-area hand-area-custom">
        <!-- カードがJSで挿入されます -->
      </div>
    </div>
  </div><!-- /.battle-layout -->
</div><!-- /.game-container -->

<div slot="howto-content">
  <div
    class="howto-content"
    style="text-align: left; color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;"
  >
    <p>コマンドを選んで敵を倒していくローグライク風RPGです。</p>
    <p>敵の攻撃パターンを読んで、適切な魔法や攻撃を選択しましょう。</p>
    <p>HPが尽きないように注意しながら、連戦を勝ち抜いてください！</p>
  </div>
  <div
    class="howto-content"
    style="text-align: left; color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;"
  >
    <p>毒や火傷などの状態異常はターン終了時にダメージを受けます。</p>
    <p>回復カードを使って素早く対処しましょう。</p>
  </div>
  <div
    class="howto-content"
    style="text-align: left; color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;"
  >
    <p>「町」や「妖精」でカードを強化できます。</p>
    <p>自分だけの最強のデッキを作り上げましょう！</p>
  </div>
</div>

<style>
  .rl-overlay {
    display: none;
    background-color: rgba(0, 0, 0, 0.95);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
    text-align: center;
  }

  @keyframes slow-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.4);
      opacity: 1;
    }

    50% {
      box-shadow: 0 0 8px 4px rgba(255, 255, 255, 0.2);
      opacity: 0.7;
    }

    100% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.4);
      opacity: 1;
    }
  }

  .btn-pulse {
    animation: slow-pulse 2s infinite ease-in-out;
    border-color: #fff !important;
    color: #fff !important;
  }

  /* =============================
       バトルフィールド
       ============================= */
  .battle-field {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    /* 1fr 1fr instead of 85px auto avoids cutoff */
    gap: 12px;
    padding: 10px;
    margin-bottom: 0.3rem;
    position: relative;
    background: linear-gradient(180deg, rgba(30, 15, 5, 0.6) 0%, rgba(5, 15, 30, 0.6) 100%);
    border-radius: 8px;
    border: 1px solid #333;
    flex-shrink: 0;
    min-height: 180px;
  }

  .enemy-status-panel,
  .player-status-panel {
    padding: 0.4rem 0.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 8px;
    z-index: 2;
    align-self: center;
  }

  .enemy-status-panel {
    align-items: flex-start;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid #666;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.6);
    transform: translateX(10px);
    /* Adjust inward slightly */
  }

  .player-status-panel {
    /*align-items: flex-end;*/
    background: rgba(0, 0, 50, 0.75);
    border: 1px solid #007bff;
    box-shadow: -2px 2px 8px rgba(0, 0, 0, 0.6);
    transform: translateX(-10px);
    /* Adjust inward slightly */
  }

  .status-header {
    font-size: 0.78rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 0.15rem;
  }

  .enemy-header {
    color: #e8d5b7;
  }

  .player-header {
    color: #b7d5e8;
  }

  .poison-badge {
    font-size: 0.65rem;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
  }

  .status-label {
    font-size: 0.62rem;
    color: #ccc;
    flex-shrink: 0;
  }

  .hp-bar-bg {
    flex: 1;
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #555;
  }

  .enemy-hp-bg {
    background: #2a1a1a;
  }

  .player-hp-bg {
    background: #1a1a2a;
  }

  .hp-bar-fill {
    height: 100%;
    width: 100%;
    transition: width 0.3s;
  }

  .enemy-hp-fill {
    background: linear-gradient(90deg, #e74c3c, #e67e22);
  }

  .player-hp-fill {
    background: linear-gradient(90deg, #27ae60, #2ecc71);
  }

  .status-text {
    font-size: 0.62rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .enemy-text {
