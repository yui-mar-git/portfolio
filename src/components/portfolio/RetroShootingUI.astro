---
const { gameTitle } = Astro.props;
---

<div class="stg-wrapper">
  <!-- Global Back Button -->
  <div id="global-back-btn" class="global-back-btn" title="戻る">◀</div>

  <!-- Start Screen -->
  <div class="overlay" id="start-screen">
    <h2 class="title-main">{gameTitle || 'レトロシューティング'}</h2>
    <p class="desc-sub">
      迫りくるインベーダー隊列を撃破しよう！<br />※スタートするとBGMが鳴ります
    </p>
    <button id="start-btn" class="btn btn-primary start-btn-wide">スタート</button>
    <button id="howto-btn" class="btn btn-secondary start-btn-wide howto-margin">遊び方</button>
    <div class="start-bottom-actions">
      <button id="btn-reset-data" class="btn btn-sub-reset">データリセット</button>
      <button id="btn-open-achievements" class="btn btn-sub-achieve">実績</button>
    </div>
    <span id="start-config-btn" class="icon-config" title="コンフィグ">⚙️</span>
  </div>

  <!-- Achievements Screen (Full Overlay Page) -->
  <div id="achievements-screen" class="overlay achieve-page-overlay" style="display: none; z-index: 200;">
    <div id="btn-back-achievements" class="global-back-btn" title="戻る">◀</div>
    <div class="achievements-page-container">
      <div class="achievements-page-header">
        <h2 class="modal-title">実績</h2>
        <div id="achievements-summary-box" class="achieve-summary-box"></div>
      </div>
      <div class="achieve-tab-bar" id="stg-achieve-tab-bar">
        <button class="achieve-tab active" data-tab="all">すべて</button>
        <button class="achieve-tab" data-tab="score">スコア記録</button>
        <button class="achieve-tab" data-tab="rank">撃墜ランク</button>
      </div>
      <div class="achieve-card-grid" id="achievements-card-grid"></div>
    </div>
  </div>

  <!-- Achievement Detail Modal -->
  <div id="achieve-detail-modal" class="overlay achieve-detail-overlay" style="display: none; z-index: 250;">
    <div class="modal-inner achieve-detail-modal-inner">
      <div id="achieve-detail-badge" class="achieve-detail-badge"></div>
      <h3 id="achieve-detail-title" class="modal-title"></h3>
      <div class="achieve-detail-box">
        <div class="achieve-detail-label">【解放条件】</div>
        <div id="achieve-detail-cond" class="achieve-detail-text"></div>
        <div class="achieve-detail-label">【詳細・解説】</div>
        <div id="achieve-detail-desc" class="achieve-detail-text"></div>
      </div>
      <button id="btn-achieve-detail-close" class="btn btn-secondary btn-full">閉じる</button>
    </div>
  </div>

  <!-- Data Reset Confirm Modal -->
  <div id="data-reset-modal" class="overlay data-reset-modal-overlay" style="display: none; z-index: 200;">
    <div class="modal-inner data-reset-modal-card">
      <h2 class="modal-title reset-modal-title">データリセット</h2>
      <p class="reset-modal-desc">ハイスコアおよび到達WAVE記録を初期化しますか？</p>
      <p class="reset-modal-warning">※この操作は取り消せません。</p>
      <div class="reset-modal-btn-row">
        <button id="btn-cancel-reset" class="btn btn-secondary">キャンセル</button>
        <button id="btn-confirm-reset" class="btn btn-danger">リセットする</button>
      </div>
    </div>
  </div>

  <!-- Result Screen -->
  <div class="overlay" id="result-screen">
    <h2 class="result-win">GAME OVER</h2>
    <div id="result-message" class="result-message-box">
      <div>スコア: <span id="final-score" class="score-highlight">0</span></div>
      <div>ハイスコア: <span id="final-high-score" class="score-highlight">0</span></div>
      <div id="new-record-tag" class="new-record-tag">NEW RECORD!</div>
    </div>
    <div class="stage-buttons">
      <button id="btn-retry" class="btn btn-primary">もう一度挑戦</button>
      <button id="btn-to-start" class="btn btn-secondary">タイトルへ</button>
    </div>
  </div>

  <!-- WAVE Start Announcement Overlay -->
  <div class="overlay" id="wave-start-modal" style="display: none;">
    <div class="wave-announce-box">
      <div class="wave-badge">INVASION ALERT</div>
      <h2 id="wave-announce-title" class="wave-title">WAVE 1</h2>
      <p id="wave-announce-desc" class="wave-desc">エネミー接近中！殲滅せよ！</p>
      <button id="btn-wave-start" class="btn btn-primary btn-wave-start">出撃</button>
    </div>
  </div>

  <!-- Game UI Header (HUD) -->
  <div class="game-ui-header">
    <div class="status-bar">
      <div>SCORE: <span id="score-display">0</span></div>
      <div class="text-hi">BEST: <span id="high-score-display">0</span></div>
      <div class="text-wave">WAVE: <span id="wave-display">1</span></div>
      <div class="text-lives">LIFE: <span id="lives-display">❤️❤️❤️</span></div>
      <span id="config-btn" class="icon-config config-btn-inline" title="コンフィグ">⚙️</span>
    </div>
  </div>
</div>

<style>
  :global(#game-container) {
    --game-height: 600px;
    position: relative;
    height: 600px;
  }

  .stg-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    z-index: 10;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 23, 42, 0.92);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 20;
    color: white;
    padding: 2rem;
    box-sizing: border-box;
    backdrop-filter: blur(8px);
    pointer-events: auto;
  }

  #result-screen {
    display: none;
  }

  .title-main {
    margin-bottom: 0.5rem;
    font-size: 2rem;
    font-weight: bold;
    color: #ffffff;
  }

  .desc-sub {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 0.9rem;
    text-align: center;
  }

  .start-btn-wide {
    width: 80%;
    max-width: 300px;
  }

  .howto-margin {
    margin-top: 1rem;
  }

  .global-back-btn {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 36px;
    height: 36px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1.2rem;
    z-index: 50;
    transition: background 0.2s;
    pointer-events: auto;
  }

  #global-back-btn {
    display: none;
  }

  .global-back-btn:hover {
    background: rgba(0, 0, 0, 0.9);
  }

  .game-ui-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    pointer-events: none;
  }

  .status-bar {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    background: rgba(15, 23, 42, 0.85);
    padding: 0.8rem 1rem 0.8rem 3.5rem;
    color: white;
    font-weight: bold;
    font-size: 1.05rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    pointer-events: auto;
    box-sizing: border-box;
  }

  .text-hi {
    color: #ffd700;
  }

  .text-wave {
    color: #00bfff;
  }

  .text-lives {
    color: #ff4d4d;
    letter-spacing: 2px;
  }

  .config-btn-inline {
    cursor: pointer;
    margin-left: auto;
    display: flex;
    align-items: center;
    line-height: 1;
    font-size: 1.4rem;
  }

  .icon-config {
    cursor: pointer;
    font-size: 1.5rem;
    transition: transform 0.2s;
  }

  .icon-config:hover {
    transform: rotate(45deg);
  }

  .result-win {
    font-size: 2.5rem;
    color: #00f2fe;
    text-shadow: 0 0 12px rgba(0, 242, 254, 0.6);
    margin-bottom: 1.5rem;
  }

  .result-message-box {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 1.2rem 2rem;
    margin-bottom: 1.8rem;
    font-size: 1.2rem;
    text-align: center;
    line-height: 1.8;
  }

  .score-highlight {
    font-weight: 800;
    color: #ffd700;
    font-size: 1.4rem;
  }

  .new-record-tag {
    display: none;
    color: #ff4500;
    font-weight: bold;
    font-size: 1rem;
    margin-top: 0.4rem;
    animation: blink 0.8s infinite alternate;
  }

  @keyframes blink {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.3;
    }
  }

  .stage-buttons {
    display: flex;
    gap: 1rem;
  }

  /* WAVE Start Modal Styles */
  #wave-start-modal {
    background-color: rgba(15, 23, 42, 0.85);
    display: none;
    z-index: 25;
  }

  .wave-announce-box {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.96), rgba(15, 23, 42, 0.98));
    border: 2px solid #00f2fe;
    box-shadow: 0 0 25px rgba(0, 242, 254, 0.45);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    animation: wavePopup 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes wavePopup {
    0% { transform: scale(0.7); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .wave-badge {
    font-size: 0.75rem;
    font-weight: bold;
    letter-spacing: 0.1em;
    color: #00f2fe;
    background: rgba(0, 242, 254, 0.15);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .wave-title {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #ffffff;
    text-shadow: 0 0 12px rgba(0, 242, 254, 0.6);
    margin: 0;
  }

  .wave-desc {
    font-size: 0.95rem;
    color: #94a3b8;
    margin: 0;
  }

  .btn-wave-start {
    margin-top: 0.5rem;
    padding: 0.6rem 2.2rem;
    font-size: 1rem;
    font-weight: bold;
  }

  .achieve-stats-group {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 10px;
    margin-bottom: 12px;
  }
  .achieve-stat-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #cbd5e1;
    padding: 3px 0;
  }
  .achieve-stat-item strong {
    color: #fbbf24;
  }
  .achieve-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
    max-height: 200px;
    overflow-y: auto;
  }
  .achieve-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px 12px;
  }
  .achieve-item.unlocked {
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
  }
  .achieve-item.locked {
    opacity: 0.45;
  }
  .achieve-icon {
    font-size: 1.4rem;
  }
  .achieve-info {
    text-align: left;
  }
  .achieve-name {
    font-size: 0.85rem;
    font-weight: bold;
    color: #f8fafc;
  }
  .achieve-desc {
    font-size: 0.72rem;
    color: #94a3b8;
  }
  .modal-desc-sub {
    font-size: 0.75rem;
    color: #ef4444;
    margin-bottom: 1rem;
  }
  .modal-btn-row {
    display: flex;
    gap: 10px;
    justify-content: center;
  }
</style>
