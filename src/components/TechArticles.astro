---
import { getTechArticles, type TechArticle } from '@/lib/notes';
import zennIcon from '@/assets/icons/brands/zenn.svg';
import qiitaIcon from '@/assets/icons/brands/qiita-icon.png';
import noteIcon from '@/assets/icons/brands/note.svg';

interface Props {
  title?: string;
  limit?: number;
}

const { title = '最新技術記事・備忘録', limit = 6 } = Astro.props;

function getBrandIconSrc(source: string): string {
  const icons: Record<string, any> = {
    Qiita: qiitaIcon,
    Zenn: zennIcon,
    note: noteIcon,
  };
  const icon = icons[source];
  if (!icon) return '';
  return typeof icon === 'string' ? icon : icon.src || '';
}

let articles: TechArticle[] = [];

try {
  articles = await getTechArticles(limit);
} catch (e) {
  console.error('Error in TechArticles component:', e);
  articles = [];
}
---

<section class="tech-articles-section">
  {title && <h2 class="tech-articles-heading">{title}</h2>}

  {
    articles.length > 0 ? (
      <div class="tech-articles-grid">
        {articles.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="tech-article-card"
          >
            <div class="tech-article-eyecatch">
              {item.thumbnail ? (
                <img src={item.thumbnail} alt="" class="eyecatch-img" loading="lazy" />
              ) : (
                <div class={`eyecatch-placeholder placeholder-${item.source.toLowerCase()}`}>
                  {getBrandIconSrc(item.source) && (
                    <img
                      src={getBrandIconSrc(item.source)}
                      alt={item.source}
                      class="default-brand-icon"
                    />
                  )}
                </div>
              )}
            </div>

            <div class="tech-article-body">
              <div class="tech-article-header">
                <span class={`source-badge badge-${item.source.toLowerCase()}`}>
                  {item.source}
                </span>
                {item.date && (
                  <time class="tech-article-date" datetime={item.date}>
                    {item.date}
                  </time>
                )}
              </div>
              <h3 class="tech-article-title" title={item.title}>
                {item.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="tech-articles-fallback">
        <p>現在記事を取得できません。</p>
      </div>
    )
  }
</section>

<style>
  .tech-articles-section {
    width: 100%;
    margin: 2rem 0;
  }

  .tech-articles-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color, #f8fafc);
    margin-bottom: 1.25rem;
  }

  .tech-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .tech-article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .tech-article-card:hover {
    transform: translateY(-3px);
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }

  .tech-article-eyecatch {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(15, 23, 42, 0.8);
    position: relative;
  }

  .eyecatch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .tech-article-card:hover .eyecatch-img {
    transform: scale(1.05);
  }

  .eyecatch-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .default-brand-icon {
    height: 50%;
    max-width: 50%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .tech-article-card:hover .default-brand-icon {
    transform: scale(1.08);
  }

  .tech-article-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .tech-article-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .source-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .badge-qiita {
    background-color: #55c500;
  }

  .badge-zenn {
    background-color: #3ea8ff;
  }

  .badge-note {
    background-color: #2cb696;
  }

  .tech-article-date {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
  }

  .tech-article-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-color, #f8fafc);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tech-articles-fallback {
    padding: 2rem;
    text-align: center;
    background: rgba(30, 41, 59, 0.4);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    color: var(--text-muted, #94a3b8);
    font-size: 0.95rem;
  }

  /* タブレット(900px以下): 2列 */
  @media (max-width: 900px) {
    .tech-articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* SP(600px以下): 1列・横並びサムネイルカードに切り替え */
  @media (max-width: 600px) {
    .tech-articles-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .tech-article-card {
      flex-direction: row;
      align-items: stretch;
    }

    .tech-article-eyecatch {
      width: 88px;
      min-width: 88px;
      aspect-ratio: 1 / 1;
      border-radius: 10px 0 0 10px;
      padding: 4px;
    }

    .eyecatch-img {
      border-radius: 6px;
    }

    .eyecatch-placeholder {
      border-radius: 6px;
    }

    .default-brand-icon {
      height: 40%;
      max-width: 40%;
    }

    .tech-article-body {
      padding: 0.75rem;
      gap: 0.4rem;
      justify-content: center;
      min-width: 0;
    }

    .tech-article-title {
      font-size: 0.9rem;
    }

    .source-badge {
      font-size: 0.7rem;
      padding: 0.15rem 0.45rem;
    }

    .tech-article-date {
      font-size: 0.7rem;
    }
  }
</style>
